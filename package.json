{
  "name": "restaurant-floorplan-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build && tsc -p tsconfig.server.json",
    "build:desktop": "npm run build && electron-builder",
    "desktop": "concurrently \"npm:dev:server\" \"npm:dev:client\" \"wait-on http://127.0.0.1:5173 && electron electron/main.cjs\"",
    "test:nano-banana": "node scripts/test-nano-banana.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.561.0",
    "multer": "^2.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "wait-on": "^9.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "nl.restaurant.floorplanai",
    "productName": "Restaurant Plattegrond AI",
    "files": [
      "dist/**/*",
      "server-dist/**/*",
      "server/**/*",
      "shared/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design"
    },
    "directories": {
      "output": "outputs/desktop"
    }
  }
}
